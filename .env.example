# Local/private backend environment variables. Never commit real values.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Optional: the model name shown to users; must match MODEL_ID in runpod_worker/Dockerfile.
# RUNPOD_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
# Optional alternative (must be on api.runpod.ai):
# RUNPOD_ENDPOINT_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID

# Optional: required to refresh trend signals from other machines (Authorization: Bearer <token>).
ADMIN_TOKEN=
# Opt-in keyword-only checks; new evidence stays pending until admin approval.
# Default 0 (off). Development can use 24; public demo always disables checks.
SIGNALS_REFRESH_HOURS=0

# For publishing a synthetic-only, shared-access demonstration on Replit:
# FUTUREPATH_PUBLIC_DEMO=1
# FUTUREPATH_DEMO_PASSWORD=GENERATE_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
# SIGNALS_REFRESH_HOURS=0
# FUTUREPATH_DB=/tmp/futurepath_demo.sqlite3
# The demo password gates all pages and APIs. Shared demo profiles are NOT private per visitor.

# Optional remote admin refresh of trend feeds (only in private development):
# ADMIN_TOKEN=USE_A_UNIQUE_LONG_RANDOM_SECRET
# Configure as a Replit Secret. An administrator enters it only when prompted.
# FUTUREPATH_PUBLIC_DEMO=1 disables manual live refresh, even for admins.

# Read-only verified evidence snapshot from the daily GitHub Actions workflow.
# Enabled by default; set to 0 only to deliberately disable remote evidence.
SIGNALS_REMOTE_SNAPSHOT_ENABLED=1
# Automatic publication requires GitHub Actions variable SIGNALS_AUTO_AI_ENABLED=1
# AND an ANTHROPIC_API_KEY Actions secret. Without both, checks use keywords
# and cannot publish new evidence. Never commit credentials.
