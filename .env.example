# Local/private backend environment variables. Never commit real values.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Optional alternative (must be on api.runpod.ai):
# RUNPOD_ENDPOINT_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID

# Optional: required to refresh trend signals from other machines (Authorization: Bearer <token>).
ADMIN_TOKEN=
# Optional: hours between automatic signal refreshes while the server runs (default 24; 0 turns it off).
SIGNALS_REFRESH_HOURS=24

# For publishing a synthetic-only, shared-access demonstration on Replit:
# FUTUREPATH_PUBLIC_DEMO=1
# FUTUREPATH_DEMO_PASSWORD=GENERATE_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
# SIGNALS_REFRESH_HOURS=0
# FUTUREPATH_DB=/tmp/futurepath_demo.sqlite3
# The demo password gates all pages and APIs. Shared demo profiles are NOT private per visitor.
